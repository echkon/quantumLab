# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.
# On Render, set these same keys in the service's Environment tab instead.

# --- Django core ---------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-freshly-generated-key

# 1 / true for local development, leave unset (or 0) in production.
DJANGO_DEBUG=1

# Comma-separated.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,quantumlab.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://quantumlab.onrender.com

# --- Database ------------------------------------------------------------
# Defaults to local SQLite if unset.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Email (OPTIONAL) ----------------------------------------------------
# Uploads are saved to media/uploads/ regardless of these settings.
# Leave EMAIL_HOST_PASSWORD empty (or omit this whole block) and no
# notification email is attempted — the upload still works.
#
# To enable notifications, create a Gmail app password at
# https://myaccount.google.com/apppasswords and fill in all four lines.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=
# UPLOAD_NOTIFY_EMAIL=your-address@gmail.com
